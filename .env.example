# =========================================================================
# Exemplo de variaveis de ambiente. Copie para .env e ajuste os valores.
#   cp .env.example .env
# O arquivo .env NAO deve ser commitado (ver .gitignore).
# =========================================================================

# Ambiente: development | production | test
NODE_ENV=development

# Porta do servidor local
PORT=3000

# Fonte de dados: "memory" (sem banco, ideal p/ dev e testes) ou "supabase"
# Em memoria os dados sao reiniciados a cada restart.
DATA_SOURCE=memory

# ------------------------------------------------------------------------
# JWT (autenticacao) - RF02 / RNF03
# Em producao, gere um segredo forte (ex.: openssl rand -hex 32) e defina
# como variavel de ambiente na Vercel. NUNCA use o valor de exemplo abaixo.
# ------------------------------------------------------------------------
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------
# Supabase (obrigatorio apenas quando DATA_SOURCE=supabase) - RNF05
# Painel Supabase > Project Settings > API
#   SUPABASE_URL  = Project URL
#   SUPABASE_KEY  = service_role key (backend) OU anon key, conforme RLS
# ------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------------------------------------
# CORS - origem permitida para o frontend (RNF01 / consumo da API)
# Use "*" em dev; em producao defina a URL do frontend na Vercel.
# ------------------------------------------------------------------------
CORS_ORIGIN=*

# Popular dados de exemplo (salas + usuario admin) quando DATA_SOURCE=memory.
# Util para o frontend testar localmente. Nao afeta os testes automatizados.
SEED_DEV=true
